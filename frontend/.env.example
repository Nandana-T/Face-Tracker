# Vite build-time variables are PUBLIC: they end up in the browser bundle. Never put a secret here.
# Production (Vercel project environment variable): the absolute URL of the API, including /api/v1.
VITE_API_BASE_URL=https://<your-api>.onrender.com/api/v1
# Development uses the Vite proxy (relative /api/v1); the proxy target is:
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
