{
  "video": {
    "source_type": "file",
    "source": "",
    "reconnect_interval_seconds": 5,
    "sample_dir": "datasets/samples",
    "sources": [],
    "rtsp": {
      "connect_timeout_seconds": 10,
      "read_timeout_seconds": 10,
      "max_reconnect_attempts": 0,
      "max_backoff_seconds": 30
    },
    "max_consecutive_read_failures": 30
  },
  "detection": {
    "frame_skip": 2,
    "confidence_threshold": 0.5,
    "model": "yolov11n-face",
    "input_size": 640,
    "iou_threshold": 0.45,
    "max_faces": 100,
    "intra_op_threads": 4,
    "cpu_spin_wait": false
  },
  "worker": {
    "queue_size": 4,
    "realtime_pacing": true,
    "heartbeat_interval_seconds": 5,
    "stats_interval_seconds": 1,
    "start_timeout_seconds": 30,
    "stop_timeout_seconds": 10
  },
  "stream": {
    "max_fps": 15,
    "max_width": 960,
    "jpeg_quality": 70
  },
  "recognition": {
    "similarity_threshold": 0.50,
    "novelty_threshold": 0.40
  },
  "tracking": {
    "enabled": true,
    "high_confidence": 0.6,
    "confirm_hits": 3,
    "tentative_timeout_seconds": 0.5,
    "max_missing_seconds": 2,
    "match_iou": 0.2,
    "low_match_iou": 0.3,
    "lost_match_iou": 0.1,
    "box_buffer": 0.1,
    "lost_velocity_decay_per_second": 1.0,
    "max_tracks": 200
  },
  "visits": {
    "missing_after_seconds": 1.5,
    "exit_after_seconds": 8,
    "max_frame_gap_seconds": 2,
    "evidence_dir": "logs"
  },
  "logging": {
    "level": "INFO",
    "events_file": "logs/events.log"
  }
}
