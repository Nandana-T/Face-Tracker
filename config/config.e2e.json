    "reconnect_interval_seconds": 5,
    "sample_dir": "datasets/none",
    "upload_dir": "datasets/e2e/uploads",
    "sources": [
      {
        "id": "e2e-align",
        "label": "E2E alignment clip",
        "type": "file",
        "path": "datasets/e2e/alignment.mp4"
      },
      {
        "id": "e2e-leaves",
        "label": "E2E leaves clip",
        "type": "file",
        "path": "datasets/e2e/leaves.mp4"
      },
      {
        "id": "e2e-long",
        "label": "E2E long clip",
        "type": "file",
        "path": "datasets/e2e/long.mp4"
      },
      {
        "id": "e2e-person-b1",
        "label": "E2E person B photo 1",
        "type": "file",
        "path": "datasets/e2e/person-b1.mp4"
      },
      {
        "id": "e2e-person-b2",
        "label": "E2E person B photo 2",
        "type": "file",
        "path": "datasets/e2e/person-b2.mp4"
      },
      {
        "id": "e2e-broken",
        "label": "E2E broken file",
        "type": "file",
        "path": "datasets/e2e/broken.mp4"
      },
      {
        "id": "e2e-missing",
        "label": "E2E missing clip",
        "type": "file",
        "path": "datasets/e2e/missing.mp4"
      }
    ]
  },
  "detection": {
    "frame_skip": 2,
    "confidence_threshold": 0.5,
    "intra_op_threads": 4
  },
  "worker": {
    "realtime_pacing": true,
    "heartbeat_interval_seconds": 2,
    "stats_interval_seconds": 0.5,
    "start_timeout_seconds": 30,
    "stop_timeout_seconds": 10
  },
  "recognition": {
    "similarity_threshold": 0.50,
    "novelty_threshold": 0.40,
    "faces_dir": "datasets/e2e/faces"
  },
  "tracking": {
    "enabled": true,
    "high_confidence": 0.6,
    "confirm_hits": 3,
    "tentative_timeout_seconds": 0.5,
    "max_missing_seconds": 2,
    "match_iou": 0.2,
    "low_match_iou": 0.3,
    "lost_match_iou": 0.1,
    "box_buffer": 0.1,
    "lost_velocity_decay_per_second": 1.0,
    "max_tracks": 200
  },
  "visits": {
    "missing_after_seconds": 1,
    "exit_after_seconds": 3,
    "evidence_dir": "datasets/e2e/evidence"
  },
  "logging": {
    "level": "INFO",
    "events_file": "logs/e2e-events.log"
  }
}
