# Copy to .env (never commit .env). Relative paths resolve against the project root.

APP_ENV=development            # development | test | production

# --- Database ---------------------------------------------------------------
# Local PostgreSQL (see docker-compose.yml):
DATABASE_URL=postgresql://katomaran:katomaran@localhost:5432/katomaran
# Hosted (Supabase direct connection) - TLS is mandatory, keep sslmode=require.
# URL-encode special characters in the password (e.g. $ -> %24, @ -> %40).
# DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Optional isolated database for integration tests (defaults to DATABASE_URL, using a throw-away schema).
# TEST_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_CONNECT_RETRIES=2
# true when going through a transaction-mode pooler (Supabase pooler :6543 / PgBouncer)
DB_USE_PGBOUNCER=false

# --- HTTP -------------------------------------------------------------------
# Comma-separated explicit origins (no wildcard). Add your Vercel domain in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Files / directories ----------------------------------------------------
CONFIG_FILE=config/config.json
LOG_DIR=logs
STORAGE_DIR=storage
MODELS_DIR=models
# LOG_LEVEL=INFO               # overrides logging.level in config.json

# --- Caches (set by scripts/env.ps1; relevant from Phase 1 onward) -----------
# PIP_CACHE_DIR=cache/pip
# UV_CACHE_DIR=cache/uv
# npm_config_cache=cache/npm
# HF_HOME=cache/huggingface
# TORCH_HOME=cache/torch
# INSIGHTFACE_HOME=cache/insightface

# --- Frontend (Vite; build-time) ---------------------------------------------
# API base URL baked into the production build. Dev uses the Vite proxy ("/api/v1").
# VITE_API_BASE_URL=https://api.example.com/api/v1
# Dev proxy target:
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
